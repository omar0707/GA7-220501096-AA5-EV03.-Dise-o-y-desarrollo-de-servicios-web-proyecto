# ==============================================================================
# VARIABLES DE ENTORNO - CANSTYLING API REST (PLANTILLA .env.example)
# Copie este archivo como '.env' y complete con sus credenciales locales.
# ==============================================================================

# SERVIDOR WEB
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# BASE DE DATOS MYSQL (XAMPP / Servidor Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peluqueria_canina_db
DB_USER=root
DB_PASSWORD=
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_SERVER_TIMEZONE=America/Bogota

# META WHATSAPP CLOUD API (Fase 4 - Webhook & Notificaciones)
META_APP_SECRET=canstyling_meta_secret_key_2026_x89a
META_VERIFY_TOKEN=canstyling_webhook_verify_token_sena_2026
META_PHONE_NUMBER_ID=109876543210987
META_ACCESS_TOKEN=EAAG...dummy_token...ZDZD

# CLOUDINARY MEDIA (Fase 2 - Almacenamiento Fotografico)
CLOUDINARY_CLOUD_NAME=canstyling-cloud
CLOUDINARY_API_KEY=123456789012345
